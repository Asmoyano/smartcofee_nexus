# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real a GitHub

# Base de datos
# En local deja vacío para usar SQLite automáticamente
# En Railway pega la URL que te da PostgreSQL
DATABASE_URL=

# CORS - URL del frontend en Vercel (sin slash al final)
# Ejemplo: https://smartcoffee-nexus.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
